// Aws bedrock configuration
AWS_Region=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
// Optional: AWS_SESSION_TOKEN is required if using temporary session credentials (AWS Academy / Learner Lab / SSO)
// AWS_SESSION_TOKEN=your_aws_session_token

// zzmodel ID: use amazon.nova-pro-v1:0 or us.amazon.nova-pro-v1:0 (recommended cross-region)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

// If you don't want to use the other models, you can use this website without any aws_api_key